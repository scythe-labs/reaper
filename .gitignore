MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec
# PyInstaller's INPUT spec is source, not a build product: the blanket above
# silently dropped it from every commit while local builds read the untracked
# copy, and CI then had no spec at all (#427).
!packaging/pyinstaller/*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

