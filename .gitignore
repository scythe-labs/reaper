# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc


# ---> Reaper
# Local secrets — API keys, Fernet key, Plex token. NEVER commit.
# Deliberately broad: .env.backup, .env.bak, .env.save and friends all hold
# real credentials, and a narrow pattern is how they get committed by accident.
.env
.env.*
!.env.example

# The same class one step down: a credential for a service this repository talks to,
# dropped in the root by hand rather than into .env. The Cloudflare token that deploys
# the two sites and the Weblate key that opens the translation pull requests both landed
# here untracked and unmatched, one `git add -A` from being published. They share no
# extension to match on, so each spelling is named and the patterns beside them are wide
# enough to catch the next one. No tracked file matches any of these.
.weblate_api
.clouldf*
.cloudflare*
*_api
*.token

# Runtime data (SQLite DB, IMDb dataset cache, logs)
/data/

# Dev-server logs from scripts/dev-local.sh
/.dev-logs/

# The auto-generated encryption key. Normally inside /data/, but named
# explicitly so a custom REAPER_DATA_DIR cannot cause it to be committed.
secret.key
*.db
*.db-shm
*.db-wal

# Frontend
node_modules/
frontend/dist/
frontend/public/vendor/
# `npm run test:coverage` writes lcov here for CI to upload. The Python half's equivalents
# (coverage.xml, htmlcov/) are covered by the coverage block further up.
frontend/coverage/

# Agent worktrees. `git worktree add` inside the repo leaves a directory git will
# happily stage as a gitlink (mode 160000) with no .gitmodules to describe it, and
# every later `actions/checkout` then runs `git submodule foreach` against it and
# warns twice per job. One such link reached dev before this line existed.
.claude/worktrees/

# Written by the InstructionsLoaded hook (scripts/log-instructions-loaded.sh).
.claude/instructions-loaded.log

# Review findings, written by each agent as it finishes so a run that dies
# partway -- a lost session, an exhausted quota -- still leaves its verified
# work on disk. Interim artifacts: a pass worth keeping goes to docs/history/,
# and a candidate verification could not settle is filed as an issue labeled
# Status/Need More Info. Nothing whose lifespan outlives the run stays here --
# these files do not survive removal of the worktree they were written in.
.claude/review-findings/

# Written by `scripts/mutation_scope.py` on every run, one per zone. An interim
# artifact: what a run is worth keeping goes to docs/LEARNINGS.md as a finding,
# and the JSON is regenerated by the next run against different source anyway.
mutation-report-*.json

# The screenshot page is a build product; the PNG beside it is what ships.
docs/media/review-queue.html

# Docusaurus's build cache. `website/build` and `website/node_modules` are already covered by
# the `build/` and `node_modules/` rules above.
.docusaurus/

# Generated per build by scripts/write_buildinfo.py; never committed.
packaging/pyinstaller/buildinfo.json

# The Hosted Weblate API key, read by the session that configures the project. Never in a commit.
.weblate_api
