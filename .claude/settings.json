{
  "permissions": {
    "deny": [
      "Bash(sleep:*)"
    ]
  },
  "hooks": {
    "InstructionsLoaded": [
      {
        "matcher": "session_start|path_glob_match|nested_traversal|include|compact",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/log-instructions-loaded.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
