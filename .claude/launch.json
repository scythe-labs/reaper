{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "reaper-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "reaper.main:create_app", "--factory", "--no-proxy-headers", "--reload", "--port", "8420"],
      "port": 8420,
      "env": {
        "REAPER_SERVE_SPA": "false"
      }
    },
    {
      "name": "reaper-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    }
  ]
}
