{
  "name": "reaper-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "predev": "node scripts/copy-scalar.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-scalar.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs",
    "social-card": "node scripts/gen-social-card.mjs",
    "gen-wordmark": "vitest run src/brand/wordmark.gen.test.ts -u",
    "gen-manual": "vitest run src/docs/manual.gen.test.ts -u",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "mark": "node scripts/gen-mark.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.2",
    "i18next": "^26.4.3",
    "i18next-icu": "^2.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.16",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@resvg/resvg-js": "^2.6.2",
    "@scalar/api-reference": "^1.73.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "intl-messageformat": "12.1.3",
    "jsdom": "^30.1.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "8.3.5",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@scalar/json-magic": {
      "undici": "7.29.1"
    }
  }
}
