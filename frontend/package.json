{
  "name": "reaper-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "predev": "node scripts/copy-scalar.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-scalar.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs",
    "social-card": "node scripts/gen-social-card.mjs",
    "gen-wordmark": "vitest run src/brand/wordmark.gen.test.ts -u",
    "gen-manual": "vitest run src/docs/manual.gen.test.ts -u",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "mark": "node scripts/gen-mark.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "i18next": "^26.4.0",
    "i18next-icu": "^2.4.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.12",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@formatjs/icu-messageformat-parser": "3.5.17",
    "@resvg/resvg-js": "^2.6.2",
    "@scalar/api-reference": "^1.64.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.13.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "intl-messageformat": "11.2.14",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "8.2.1",
    "vitest": "^4.1.10"
  }
}
