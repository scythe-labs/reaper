# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Copy to .env.local (which is gitignored) and fill in.
# Integration API keys are NOT set here -- they are entered in the web UI and
# stored Fernet-encrypted in the database.

# OPTIONAL. Encrypts integration credentials at rest.
#
# Leave it unset and Reaper generates one on first boot, saving it to
# <data_dir>/secret.key (mode 0600) and reusing it thereafter. BACK THAT FILE UP
# with your database: losing it means every stored credential must be re-entered.
#
# Set it here (or from a secret manager) to manage the key yourself; Reaper then
# writes no key file at all. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# A short or low-entropy key is accepted but WARNED about at startup. The warning is
# advisory only (refusing would brick an install already running on that key), so
# treat it as a real prompt to rotate: if the database ever leaks, a weak key can be
# brute-forced offline even through the scrypt stretching.
#
# Whatever the key's source, Reaper also mints a random per-install salt on first
# boot, saved to <data_dir>/secret.salt (mode 0600). It makes the derived encryption
# key unique to this install. Back it up alongside secret.key.
# REAPER_SECRET_KEY=

# OPTIONAL. Retired keys, comma-separated for a chain. They are used to DECRYPT only.
#
# To rotate: put the new key in REAPER_SECRET_KEY above and move the old one here.
# Reaper then encrypts under the new key while still reading whatever the old ones
# wrote, so a rotation cannot brick your credentials halfway through. Drop the old
# value once everything has been re-saved.
# REAPER_SECRET_KEY_OLD=

# Where reaper.db and the IMDb dataset cache live.
REAPER_DATA_DIR=data

# Bind address and port. Honored by the container entrypoint, and used to build the
# recovery-mode link the app prints.
REAPER_HOST=0.0.0.0
REAPER_PORT=8420

REAPER_LOG_LEVEL=INFO
REAPER_LOG_JSON=false

# Whether a BRAND NEW install comes up able to delete. This is a first-run seed,
# not a master switch: once the value has been set in the web UI (Policy -> Deletion,
# which asks for your admin password) the stored value wins and this is ignored --
# so a declarative deployment can ship armed, and rotating the UI toggle is never
# clobbered by a stale value left here.
#
# Leave it false. While deletion is off Reaper can only scan, score and explain, and
# the refusal is enforced at the HTTP transport rather than by scattered checks, so a
# mutating request is blocked before it is sent whatever the calling code believes.
REAPER_DESTRUCTIVE_ACTIONS_ENABLED=false

# Anti-lockout. Set true and restart to print a single-use, 15-minute login link
# to the container log. Turn it back off once you are back in.
REAPER_RECOVERY=false

# ---------------------------------------------------------------------------
# Optional: notifications.
#
# The Discord webhook is the real "these titles are leaving soon" channel -- the
# Plex "Leaving Soon" label only reaches users who pinned the library, which no
# server can force. The ENTIRE URL is a secret (its token is in the path); absent
# means notifications are off. This is a first-boot SEED: on first run it is
# imported into the database (encrypted), and the web UI is the source of truth
# thereafter -- so removing it later does not silently turn notifications off, and
# a value edited in the UI is never clobbered by a stale one left here.
# REAPER_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
#
# Writing the "Leaving Soon" shelf in Plex (a collection plus a label) is a mutation,
# so by default it is gated exactly like a delete (written only once deletion is
# enabled). This is the FIRST-RUN default for allowing that reversible,
# file-touching-nothing write while Reaper is still read-only, so the warning can
# appear DURING the grace countdown -- which is the point of it. After first boot the
# switch in Settings -> Plex ("Update while read-only") is the source of truth, and a
# value edited there is never clobbered by a stale one left here. It can never permit
# a file delete.
REAPER_ALLOW_UNARMED_LEAVING_SOON=false

# ---------------------------------------------------------------------------
# Optional: seed integrations on first boot.
#
# These are imported into the database, encrypted, and can then be deleted --
# Reaper logs when that is safe. The database is the source of truth afterwards:
# an instance that already exists is NEVER overwritten from here, so rotating a
# key in the UI cannot be clobbered by a stale value left in this file.
#
# Naming: REAPER_<KIND>_<NAME>_URL and _API_KEY. <NAME> is free-form and becomes
# the instance display name. The URL already encodes scheme and port.
#
# Plex is NOT here: it is added via Sign in with Plex in the setup wizard.
#
# TLS certificate checking is per service and ON by default. Turning it off (for a
# self-signed server you run yourself) is done in the UI: per instance in Settings >
# Services, and for Plex in Settings > Plex. There is no env switch for it.
# ---------------------------------------------------------------------------
# REAPER_SONARR_HD_URL=https://sonarr.example.net
# REAPER_SONARR_HD_API_KEY=
# REAPER_SONARR_4K_URL=https://sonarr-4k.example.net
# REAPER_SONARR_4K_API_KEY=
# REAPER_RADARR_HD_URL=https://radarr.example.net
# REAPER_RADARR_HD_API_KEY=
# REAPER_TAUTULLI_MAIN_URL=https://tautulli.example.net
# REAPER_TAUTULLI_MAIN_API_KEY=
# REAPER_SEERR_MAIN_URL=https://seerr.example.net
# REAPER_SEERR_MAIN_API_KEY=
