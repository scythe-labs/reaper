# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Copy to .env.local (which is gitignored) and set only what you need. Every value
# here is OPTIONAL: Reaper boots with working defaults, and almost everything is
# configured in the web UI instead. Integration API keys in particular are normally
# entered in the UI and stored Fernet-encrypted in the database; the block at the end
# is only a first-boot convenience for declarative (docker-compose) deployments.
#
# Per-service TLS certificate checking is configured ONLY in the web UI, not here:
# Settings -> Services (and Settings -> Plex for Plex), on by default. Turn it off for a
# self-signed server you run yourself.
#
# Where a value below is true or false, Reaper reads 1/true/yes/on and 0/false/no/off, in
# any case. A typo is never read as false: depending on the key it either leaves the
# default shown or refuses to start, so a mistake here cannot quietly turn something off.


# ===========================================================================
# Core
# ===========================================================================

# Where reaper.db and the IMDb dataset cache live. Left unset, running from source uses
# ./data and the container image uses /data (bind-mount that). Set this only to relocate
# the folder -- and inside a container never set it to a relative path, or it will miss
# your bind mount.
# REAPER_DATA_DIR=data

# Bind address and port. Honored by the container entrypoint, and used to build the
# recovery-mode link the app prints.
REAPER_HOST=0.0.0.0
REAPER_PORT=8420

# Development only, read by `scripts/dev-local.sh` and Vite. What the dev server binds to.
# Loopback when unset, which is every session with a browser on the same machine. Set it on a
# headless box, where the browser is elsewhere and a loopback-only dev server cannot be reached
# at all. It has no effect on a built image: `vite build` emits ./dist and the app serves it.
# REAPER_WEB_HOST=0.0.0.0

REAPER_LOG_LEVEL=INFO
REAPER_LOG_JSON=false

# The server time zone the scheduler's timed jobs run on -- the nightly scan and the
# upkeep jobs. An IANA name like America/New_York, so a scan set for 2 AM runs at 2 AM
# here, not in the container's own zone (UTC in most images). Left unset, Reaper detects
# the host's zone. Only the first-run default; after that Settings -> General is the live
# control.
# REAPER_TIMEZONE=America/New_York

# Checking for updates asks GitHub for the newest release (or, on a dev build, the tip
# of the dev branch). The "Check for updates" job asks nightly, so an install nobody
# opens still finds out; opening Reaper asks too, held for hours between asks. The
# schedule is editable under Settings, Jobs.
# Only version numbers travel; nothing about your library leaves the box. Set false and
# no request is made at all, on either path.
# REAPER_UPDATE_CHECK=true

# The Windows and macOS binaries open your browser once the server is up, because a
# double-click gives no other sign it worked. Set false to stop that. The container
# and the snap never do it.
# REAPER_LAUNCH_BROWSER=true

# The Windows and macOS binaries keep a menu-bar/tray icon while the server runs, with
# Open Reaper and Quit. Set false to hide it; on macOS that leaves the app with no
# visible presence, and quitting means Activity Monitor. The container and the snap
# never show one.
# REAPER_TRAY=true

# The macOS app is a menu-bar app with no Dock icon. Set true to show the Dock icon
# too. Ignored everywhere else.
# REAPER_DOCK_ICON=false


# ===========================================================================
# Reverse proxy
# ===========================================================================
# Only set these if Reaper sits behind a reverse proxy (Nginx, Traefik, Caddy, ...).
#
# Off by default, Reaper ignores forwarded headers and treats the connecting address as
# the client. Behind a proxy that means EVERY request looks like it came from the proxy,
# so the per-IP login lockout can't tell your users apart. Turn trust on and list the
# proxy's address, and Reaper reads the real client address from X-Forwarded-For for that
# one hop. A forwarded header from any address you did NOT list is ignored: an untrusted
# one is attacker-controlled, and believing it would let a stranger spoof addresses to
# dodge the lockout.
#
# List the address Reaper SEES the proxy connect from (the container's view: often the
# Docker gateway or the proxy's LAN IP, not its public one). Comma- or space-separated,
# single addresses or CIDR ranges.
#
# These are FIRST-BOOT SEEDS: they set the starting value, then Settings -> General is the
# source of truth. A value changed there is never clobbered by a stale one left here; if
# you only ever set trust here, removing it reverts to off (fail closed).
# REAPER_PROXY_TRUST_ENABLED=true
# REAPER_TRUSTED_PROXIES=172.16.0.0/12, 10.0.0.5


# ===========================================================================
# Docker file ownership (container only)
# ===========================================================================
# The container briefly starts as root to fix the data folder's ownership, then drops
# to this user for everything else. Set these to the uid:gid that owns your mounted
# data folder; default 1000:1000. On Unraid, 99:100 keeps appdata as nobody:users.
# Ignored when you run from source, or when you pin `user:` in compose.
# PUID=1000
# PGID=1000


# ===========================================================================
# Encryption at rest
# ===========================================================================

# OPTIONAL. Encrypts integration credentials at rest.
#
# Leave it unset and Reaper generates one on first boot, saving it to
# <data_dir>/secret.key (mode 0600) and reusing it thereafter. BACK THAT FILE UP
# with your database: losing it means every stored credential must be re-entered.
#
# Set it here (or from a secret manager) to manage the key yourself; Reaper then
# writes no key file at all. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# A short or low-entropy key is accepted but WARNED about at startup. The warning is
# advisory only (refusing would brick an install already running on that key), so
# treat it as a real prompt to rotate: if the database ever leaks, a weak key can be
# brute-forced offline even through the scrypt stretching.
#
# Whatever the key's source, Reaper also mints a random per-install salt on first
# boot, saved to <data_dir>/secret.salt (mode 0600). It makes the derived encryption
# key unique to this install. Back it up alongside secret.key.
# REAPER_SECRET_KEY=

# OPTIONAL. Retired keys, comma-separated for a chain. They are used to DECRYPT only.
#
# To rotate: put the new key in REAPER_SECRET_KEY above and move the old one here.
# Reaper then encrypts under the new key while still reading whatever the old ones
# wrote, so a rotation cannot brick your credentials halfway through. Drop the old
# value once everything has been re-saved.
# REAPER_SECRET_KEY_OLD=


# ===========================================================================
# Safety
# ===========================================================================

# Whether a BRAND NEW install comes up able to delete. This is a first-run seed,
# not a master switch: once the value has been set in the web UI (Policy -> Deletion,
# which asks for your admin password) the stored value wins and this is ignored --
# so a declarative deployment can ship armed, and rotating the UI toggle is never
# clobbered by a stale value left here.
#
# Leave it false. While deletion is off Reaper can only scan, score and explain, and
# the refusal is enforced at the HTTP transport rather than by scattered checks, so a
# mutating request is blocked before it is sent whatever the calling code believes.
REAPER_DESTRUCTIVE_ACTIONS_ENABLED=false

# Anti-lockout. Set true and restart to mint a single-use, 15-minute sign-in code. It
# goes to the console AND to recovery.txt in the data folder, because a double-clicked
# Windows or macOS app has no console to print to. Signing in with it lets you set a new
# admin password without the old one. Turn it back off once you are back in.
REAPER_RECOVERY=false


# ===========================================================================
# Notifications
# ===========================================================================

# The Discord webhook is the real "these titles are leaving soon" channel -- the
# Plex "Leaving Soon" label only reaches users who pinned the library, which no
# server can force. The ENTIRE URL is a secret (its token is in the path); absent
# means notifications are off. This is a first-boot SEED: on first run it is
# imported into the database (encrypted), and the web UI is the source of truth
# thereafter -- so removing it later does not silently turn notifications off, and
# a value edited in the UI is never clobbered by a stale one left here.
# REAPER_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...

# Writing the "Leaving Soon" shelf in Plex (a collection plus a label) is a mutation,
# so by default it is gated exactly like a delete (written only once deletion is
# enabled). This is the FIRST-RUN default for allowing that reversible,
# file-touching-nothing write while Reaper is still read-only, so the warning can
# appear DURING the grace countdown -- which is the point of it. After first boot the
# switch in Settings -> Plex ("Update while read-only") is the source of truth, and a
# value edited there is never clobbered by a stale one left here. It can never permit
# a file delete.
REAPER_ALLOW_UNARMED_LEAVING_SOON=false


# ===========================================================================
# Seed integrations on first boot (optional)
# ===========================================================================
# A convenience for declarative deployments: instances declared here are imported into
# the database (encrypted) on first boot, and can then be deleted -- Reaper logs when
# that is safe. The database is the source of truth afterward: an instance that already
# exists is NEVER overwritten from here, so rotating a key in the UI cannot be clobbered
# by a stale value left in this file.
#
# Plex is NOT seeded here: add it with "Sign in with Plex" in the setup wizard.
#
# Naming:  REAPER_<KIND>_<SLOT>_URL   and   REAPER_<KIND>_<SLOT>_API_KEY
#   KIND  one of: SONARR, RADARR, TAUTULLI, SEERR
#   SLOT  a short label you choose (HD, 4K, MAIN, ...). Case is ignored, so "hd" and "HD"
#         are one instance, not two. It also becomes the instance's display name unless
#         you also set REAPER_<KIND>_<SLOT>_NAME.
#   URL   the full base URL: scheme, host, port, and any base path (like /sonarr).
# A group missing either its URL or its API key is skipped, never half-imported.
#
# What each kind is for: Radarr your movies, Sonarr your TV shows (needed for season
# pruning), Tautulli your watch history, Seerr your requests. At least one of Radarr or
# Sonarr is required, and Tautulli is required (it is how Reaper knows what is watched).
# Default ports: Radarr 7878, Sonarr 8989, Tautulli 8181, Seerr 5055.
#
# ---- Multiple instances of one kind: just give each a different SLOT ----

# Two Sonarr instances, one HD and one 4K:
# REAPER_SONARR_HD_URL=https://sonarr.example.net
# REAPER_SONARR_HD_API_KEY=your-sonarr-hd-key
# REAPER_SONARR_4K_URL=https://sonarr-4k.example.net
# REAPER_SONARR_4K_API_KEY=your-sonarr-4k-key

# Two Radarr instances, the second with an explicit display name:
# REAPER_RADARR_HD_URL=https://radarr.example.net
# REAPER_RADARR_HD_API_KEY=your-radarr-hd-key
# REAPER_RADARR_4K_URL=https://radarr-4k.example.net
# REAPER_RADARR_4K_API_KEY=your-radarr-4k-key
# REAPER_RADARR_4K_NAME=Radarr 4K

# One Tautulli and one Seerr (SLOT can be anything; "MAIN" here):
# REAPER_TAUTULLI_MAIN_URL=https://tautulli.example.net
# REAPER_TAUTULLI_MAIN_API_KEY=your-tautulli-key
# REAPER_SEERR_MAIN_URL=https://seerr.example.net
# REAPER_SEERR_MAIN_API_KEY=your-seerr-key


# ===========================================================================
# Advanced (leave this alone)
# ===========================================================================
# Development only. The shipped container serves both the API and the built web UI on
# one port, which is what you want. It is set to false only in the dev setup (where Vite
# serves the UI live and proxies /api), so the built copy does not shadow the live one.
# In production, leave it unset.
# REAPER_SERVE_SPA=true
